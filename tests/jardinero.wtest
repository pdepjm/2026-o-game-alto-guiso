const mapaConEsquinaIzquierda = new Nivel(
  numero = 93,
  tiempoIdeal = 10,
  desbloqueado = true,
  mapa = [
    "#######",
    "#     #",
    "#J I  #",
    "#    r#",
    "#######"
  ]
)

describe "Las esquinas del jardín" {

  method initialize() {
    game.width(7 * escalaTablero.factor())
    game.height(5 * escalaTablero.factor())
  }

  method deslizar(direccion) {
    jardinero.mover(direccion)
    (1 .. 10).forEach({ paso => if (jardinero.estaDeslizando()) jardinero.avanzarUnPaso() })
  }

  test "la esquina derecha gira y el jardinero sigue hasta la cerca" {
    partida.nivel(mapaConEsquinaDerecha)
    partida.mostrar()

    self.deslizar(derecha)

    assert.equals(escalaTablero.posicionCelda(3, 1), jardinero.position())
    assert.equals(abajo, jardinero.direccion())
    assert.notThat(jardinero.estaDeslizando())
  }

  test "la esquina izquierda gira y el jardinero sigue hasta la cerca" {
    partida.nivel(mapaConEsquinaIzquierda)
    partida.mostrar()

    self.deslizar(derecha)

    assert.equals(escalaTablero.posicionCelda(3, 3), jardinero.position())
    assert.equals(arriba, jardinero.direccion())
    assert.notThat(jardinero.estaDeslizando())
  }

  test "la esquina mantiene el cambio de eje aunque el paso de salida esté bloqueado" {
    partida.nivel(mapaConEsquinaBloqueada)
    partida.mostrar()

    self.deslizar(derecha)

    assert.equals(escalaTablero.posicionCelda(2, 2), jardinero.position())
    assert.equals(abajo, jardinero.direccion())
    assert.notThat(jardinero.estaDeslizando())
  }

  test "cada orientación cambia entre los dos ejes para cualquier sentido de entrada" {
    jardinero.empezarEn(game.at(100, 100))
    jardinero.mover(arriba)
    jardinero.frenar()
    jardinero.girar(giroDerecha)
    assert.equals(derecha, jardinero.direccion())

    jardinero.empezarEn(game.at(100, 100))
    jardinero.mover(abajo)
    jardinero.frenar()
    jardinero.girar(giroDerecha)
    assert.equals(izquierda, jardinero.direccion())

    jardinero.empezarEn(game.at(100, 100))
    jardinero.mover(izquierda)
    jardinero.frenar()
    jardinero.girar(giroDerecha)
    assert.equals(arriba, jardinero.direccion())

    jardinero.empezarEn(game.at(100, 100))
    jardinero.mover(derecha)
    jardinero.frenar()
    jardinero.girar(giroDerecha)
    assert.equals(abajo, jardinero.direccion())

    jardinero.empezarEn(game.at(100, 100))
    jardinero.mover(arriba)
    jardinero.frenar()
    jardinero.girar(giroIzquierda)
    assert.equals(izquierda, jardinero.direccion())

    jardinero.empezarEn(game.at(100, 100))
    jardinero.mover(abajo)
    jardinero.frenar()
    jardinero.girar(giroIzquierda)
    assert.equals(derecha, jardinero.direccion())

    jardinero.empezarEn(game.at(100, 100))
    jardinero.mover(izquierda)
    jardinero.frenar()
    jardinero.girar(giroIzquierda)
    assert.equals(abajo, jardinero.direccion())

    jardinero.empezarEn(game.at(100, 100))
    jardinero.mover(derecha)
    jardinero.frenar()
    jardinero.girar(giroIzquierda)
    assert.equals(arriba, jardinero.direccion())
  }
}

describe "Las esquinas del mapa 3" {

  method initialize() {
    game.width(21 * escalaTablero.factor())
    game.height(12 * escalaTablero.factor())
    partida.nivel(mapa3)
    partida.mostrar()
  }

  method deslizar(direccion) {
    jardinero.mover(direccion)
    (1 .. 50).forEach({ paso => jardinero.avanzarUnPaso() })
  }

  test "la esquina superior derecha cambia el eje y se detiene ante una pared" {
    jardinero.empezarEn(escalaTablero.posicionCelda(15, 8))
    jardinero.mover(derecha)
    jardinero.avanzarUnPaso()

    assert.equals(escalaTablero.posicionCelda(16, 8), jardinero.position())
    assert.that(jardinero.estaDeslizando())
    assert.equals(arriba, jardinero.direccion())
    jardinero.avanzarUnPaso()
    assert.equals(escalaTablero.posicionCelda(16, 8), jardinero.position())
    assert.equals(arriba, jardinero.direccion())
    assert.notThat(jardinero.estaDeslizando())
  }

  test "se pueden florecer todas las cruces siguiendo la ruta del mapa 3" {
    self.deslizar(abajo)
    assert.equals(semillaAmarilla, jardinero.semillaEnMano())
    self.deslizar(derecha)
    assert.equals(semillaRoja, jardinero.semillaEnMano())
    self.deslizar(abajo)

    assert.that(partida.ganado())
    assert.that(partida.cruces().all({ cruz => cruz.florecida() }))
  }
}

describe "El cronometro y la nota" {

  method initialize() {
    game.width(7)
    game.height(5)
    partida.nivel(mapaDePrueba)
    partida.mostrar()
  }

  method deslizar(direccion) {
    jardinero.mover(direccion)
    (1 .. 10).forEach({ paso => if (jardinero.estaDeslizando()) jardinero.avanzarUnPaso() })
  }

  test "el cronometro arranca en cero al mostrar el nivel" {
    assert.equals(0, cronometro.segundos())
  }

  test "la nota es S si se termina dentro del tiempo ideal" {
    assert.equals("S", mapaDePrueba.notaPara(10))
  }

  test "la nota empeora a medida que se tarda mas" {
    assert.equals("A", mapaDePrueba.notaPara(20))
    assert.equals("B", mapaDePrueba.notaPara(30))
    assert.equals("C", mapaDePrueba.notaPara(40))
    assert.equals("D", mapaDePrueba.notaPara(100))
  }

  test "al ganar aparece el cartel con la medalla de la nota" {
    self.deslizar(derecha)
    self.deslizar(izquierda)
    self.deslizar(abajo)
    self.deslizar(derecha)
    assert.that(partida.ganado())
    assert.that(game.hasVisual(fondoDeVictoria))
    assert.equals("S", medalla.nota())
  }

  test "el icono de la mano muestra la semilla que lleva" {
    assert.equals(sinSemilla.imagenEnMano(), manoDelJardinero.image())
    self.deslizar(derecha)
    assert.equals(semillaRoja.imagenEnMano(), manoDelJardinero.image())
  }
}

// El tiempo y la nota se dibujan con imágenes (el motor no deja agrandar los textos),
// así que lo que se prueba es qué imagen elige cada cifra.
describe "Las cifras del cronometro" {

  test "cada cifra muestra la parte del numero que le toca" {
    cronometro.segundos(42)
    assert.equals(assetsManager.digito(4), new Digito(position = game.origin(), potencia = 10).image())
    assert.equals(assetsManager.digito(2), new Digito(position = game.origin(), potencia = 1).image())
  }

  test "los ceros de adelante no se dibujan" {
    cronometro.segundos(42)
    assert.equals(assetsManager.digitoVacio(), new Digito(position = game.origin(), potencia = 100).image())
  }

  test "en cero, las unidades igual muestran el cero" {
    cronometro.segundos(0)
    assert.equals(assetsManager.digito(0), new Digito(position = game.origin(), potencia = 1).image())
  }
}

const mapaConEspinas = new Nivel(
  numero = 94,
  tiempoIdeal = 10,
  desbloqueado = true,
  mapa = [
    "#######",
    "#J  X #",
    "#     #",
    "#r    #",
    "#######"
  ]
)

describe "Las espinas" {

  method initialize() {
    game.width(7 * escalaTablero.factor())
    game.height(5 * escalaTablero.factor())
    partida.nivel(mapaConEspinas)
    partida.mostrar()
  }

  method deslizar(direccion) {
    jardinero.mover(direccion)
    (1 .. 10).forEach({ paso => if (jardinero.estaDeslizando()) jardinero.avanzarUnPaso() })
  }

  test "pisar las espinas hace perder el nivel" {
    self.deslizar(derecha)
    assert.that(partida.perdido())
    assert.notThat(partida.ganado())
  }

  test "al perder aparece el cartel de derrota" {
    self.deslizar(derecha)
    assert.that(game.hasVisual(cartelDeDerrota))
  }

  test "una vez perdido, las flechas no mueven al jardinero" {
    self.deslizar(derecha)
    partida.presionarDireccion(abajo)
    assert.notThat(jardinero.estaDeslizando())
  }

  test "reiniciar vuelve a empezar el nivel" {
    self.deslizar(derecha)
    partida.presionarReiniciar()
    assert.notThat(partida.perdido())
    assert.notThat(game.hasVisual(cartelDeDerrota))
  }
}

const mapaConEscalera = new Nivel(
  numero = 95,
  tiempoIdeal = 10,
  desbloqueado = true,
  mapa = [
    "#######",
    "#  E  #",
    "#  E  #",
    "#J E r#",
    "#######"
  ]
)

describe "La escalera" {

  method initialize() {
    game.width(7 * escalaTablero.factor())
    game.height(5 * escalaTablero.factor())
    partida.nivel(mapaConEscalera)
    partida.mostrar()
  }

  method deslizar(direccion) {
    jardinero.mover(direccion)
    (1 .. 10).forEach({ paso => if (jardinero.estaDeslizando()) jardinero.avanzarUnPaso() })
  }

  test "al llegar a la escalera el jardinero se queda ahi" {
    self.deslizar(derecha)
    assert.equals(escalaTablero.posicionCelda(3, 1), jardinero.position())
    assert.that(jardinero.estaEnEscalera())
    assert.notThat(jardinero.estaDeslizando())
  }

  test "en la escalera sube de a un escalon por vez" {
    self.deslizar(derecha)
    jardinero.mover(arriba)
    assert.equals(escalaTablero.posicionCelda(3, 2), jardinero.position())
    assert.notThat(jardinero.estaDeslizando())
    jardinero.mover(arriba)
    assert.equals(escalaTablero.posicionCelda(3, 3), jardinero.position())
  }

  test "moviendose para el costado se baja de la escalera y vuelve a deslizarse" {
    self.deslizar(derecha)
    self.deslizar(derecha)
    assert.notThat(jardinero.estaEnEscalera())
    assert.equals(escalaTablero.posicionCelda(5, 1), jardinero.position())
  }
}

