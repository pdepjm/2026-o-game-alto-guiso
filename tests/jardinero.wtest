import wollok.game.*
import juego.partida.*
import juego.jardinero.*
import juego.direcciones.*
import juego.semillas.*
import niveles.mapa3.*
import juego.escalaTablero.*
import niveles.nivel.*

const mapaDePrueba = new Nivel(
  numero = 90,
  tiempoIdeal = 10,
  desbloqueado = true,
  mapa = [
    "#######",
    "#J r R#",
    "#     #",
    "#A a  #",
    "#######"
  ]
)

describe "El jardinero en el jardín" {

  method initialize() {
    game.width(7 * escalaTablero.factor())
    game.height(5 * escalaTablero.factor())
    partida.nivel(mapaDePrueba)
    partida.mostrar()
  }

  method deslizar(direccion) {
    jardinero.mover(direccion)
    (1 .. 10).forEach({ paso => jardinero.avanzarUnPaso() })
  }

  method cruzRoja() = partida.cruces().first()
  method cruzAzul() = partida.cruces().last()

  test "el jardinero se desliza hasta chocar con una cerca" {
    self.deslizar(derecha)
    assert.equals(escalaTablero.posicionCelda(5, 3), jardinero.position())
    assert.notThat(jardinero.estaDeslizando())
  }

  test "el movimiento avanza en subceldas" {
    jardinero.empezarEn(escalaTablero.posicionCelda(1, 3))
    jardinero.mover(derecha)
    (1 .. 3).forEach({ frame => jardinero.animarPaso() })

    assert.equals(game.at(7, 12), jardinero.position())
    assert.that(jardinero.estaDeslizando())
    jardinero.frenar()
  }

  test "al pasar por una semilla la recoge" {
    self.deslizar(derecha)
    assert.equals(semillaRoja, jardinero.semillaEnMano())
    assert.equals(semillaRoja.image(), bolsaDeSemillas.image())
    assert.that(game.hasVisual(bolsaDeSemillas))
  }

  test "sin semilla, pasar por una cruz no hace nada" {
    self.deslizar(derecha)
    assert.notThat(self.cruzRoja().florecida())
  }

  test "con la semilla del mismo color, la cruz se convierte en flor" {
    self.deslizar(derecha)
    self.deslizar(izquierda)
    assert.that(self.cruzRoja().florecida())
  }

  test "con una semilla de otro color, la cruz no florece" {
    self.deslizar(abajo)
    self.deslizar(arriba)
    self.deslizar(derecha)
    assert.notThat(self.cruzRoja().florecida())
  }

  test "agarrar otra semilla reemplaza la que tenía en la mano" {
    self.deslizar(derecha)
    self.deslizar(abajo)
    self.deslizar(izquierda)
    assert.equals(semillaAzul, jardinero.semillaEnMano())
    assert.equals(semillaAzul.image(), bolsaDeSemillas.image())
  }

  test "la semilla queda en su lugar después de recogerla" {
    self.deslizar(derecha)
    assert.that(partida.elementosEn(escalaTablero.posicionCelda(5, 3)).contains(semillaRoja))
  }

  test "no se gana hasta plantar todas las flores" {
    self.deslizar(derecha)
    self.deslizar(izquierda)
    assert.notThat(partida.ganado())
  }

  test "al plantar todas las flores se gana el nivel" {
    self.deslizar(derecha)
    self.deslizar(izquierda)
    self.deslizar(abajo)
    self.deslizar(derecha)
    assert.that(partida.ganado())
  }

  test "una vez ganado, el jardinero no se mueve más" {
    self.deslizar(derecha)
    self.deslizar(izquierda)
    self.deslizar(abajo)
    self.deslizar(derecha)
    partida.presionarDireccion(izquierda)
    assert.notThat(jardinero.estaDeslizando())
  }

  test "reiniciar deja el nivel como al principio" {
    self.deslizar(derecha)
    self.deslizar(izquierda)
    partida.presionarReiniciar()
    assert.equals(escalaTablero.posicionCelda(1, 3), jardinero.position())
    assert.equals(sinSemilla, jardinero.semillaEnMano())
    assert.notThat(self.cruzRoja().florecida())
  }
}

// Mapa aparte para probar los obstáculos, con un tablero de 7x5:
//   y=4  #######
//   y=3  #J  P #     jardinero en (1,3)   piedra en (4,3)
//   y=2  #     #
//   y=1  #R  B #     semilla roja en (1,1)   charco de barro en (4,1)
//   y=0  #######
const mapaConObstaculos = new Nivel(
  numero = 91,
  tiempoIdeal = 10,
  desbloqueado = true,
  mapa = [
    "#######",
    "#J  P #",
    "#     #",
    "#R  B #",
    "#######"
  ]
)

describe "Los obstáculos del jardín" {

  method initialize() {
    game.width(7 * escalaTablero.factor())
    game.height(5 * escalaTablero.factor())
    partida.nivel(mapaConObstaculos)
    partida.mostrar()
  }

  method deslizar(direccion) {
    jardinero.mover(direccion)
    (1 .. 10).forEach({ paso => jardinero.avanzarUnPaso() })
  }

  test "la piedra frena al jardinero igual que una cerca" {
    self.deslizar(derecha)
    assert.equals(escalaTablero.posicionCelda(3, 3), jardinero.position())
  }

  test "el charco de barro le arruina la semilla que llevaba" {
    self.deslizar(abajo)
    assert.equals(semillaRoja, jardinero.semillaEnMano())
    assert.equals(semillaRoja.image(), bolsaDeSemillas.image())
    self.deslizar(derecha)
    assert.equals(sinSemilla, jardinero.semillaEnMano())
    assert.equals(sinSemilla.imagenDeBolsa(), bolsaDeSemillas.image())
  }

  test "el charco no frena al jardinero" {
    self.deslizar(abajo)
    self.deslizar(derecha)
    assert.equals(escalaTablero.posicionCelda(5, 1), jardinero.position())
  }
}

const mapaConEsquinaDerecha = new Nivel(
  numero = 92,
  tiempoIdeal = 10,
  desbloqueado = true,
  mapa = [
    "#######",
    "#     #",
    "#J D  #",
    "#     #",
    "#######"
  ]
)

const mapaConEsquinaIzquierda = new Nivel(
  numero = 93,
  tiempoIdeal = 10,
  desbloqueado = true,
  mapa = [
    "#######",
    "#     #",
    "#J I  #",
    "#     #",
    "#######"
  ]
)

describe "Las esquinas del jardín" {

  method initialize() {
    game.width(7 * escalaTablero.factor())
    game.height(5 * escalaTablero.factor())
  }

  method deslizar(direccion) {
    jardinero.mover(direccion)
    (1 .. 10).forEach({ paso => jardinero.avanzarUnPaso() })
  }

  test "la esquina derecha gira y el jardinero sigue hasta la cerca" {
    partida.nivel(mapaConEsquinaDerecha)
    partida.mostrar()

    self.deslizar(derecha)

    assert.equals(escalaTablero.posicionCelda(3, 1), jardinero.position())
    assert.equals(abajo, jardinero.direccion())
    assert.notThat(jardinero.estaDeslizando())
  }

  test "la esquina izquierda gira y el jardinero sigue hasta la cerca" {
    partida.nivel(mapaConEsquinaIzquierda)
    partida.mostrar()

    self.deslizar(derecha)

    assert.equals(escalaTablero.posicionCelda(3, 3), jardinero.position())
    assert.equals(arriba, jardinero.direccion())
    assert.notThat(jardinero.estaDeslizando())
  }
}

describe "Las esquinas del mapa 3" {

  method initialize() {
    game.width(21 * escalaTablero.factor())
    game.height(12 * escalaTablero.factor())
    partida.nivel(mapa3)
    partida.mostrar()
  }

  method deslizar(direccion) {
    jardinero.mover(direccion)
    (1 .. 50).forEach({ paso => jardinero.avanzarUnPaso() })
  }

  test "el saco vacío se muestra fuera del mapa 3" {
    assert.that(game.hasVisual(bolsaDeSemillas))
    assert.equals(escalaTablero.posicionCelda(1, 11), bolsaDeSemillas.position())
    assert.equals(sinSemilla.imagenDeBolsa(), bolsaDeSemillas.image())
  }

  test "la esquina superior derecha del mapa 3 gira hacia la izquierda" {
    jardinero.empezarEn(escalaTablero.posicionCelda(15, 8))
    jardinero.mover(derecha)
    jardinero.avanzarUnPaso()

    assert.equals(escalaTablero.posicionCelda(16, 8), jardinero.position())
    assert.that(jardinero.estaDeslizando())
    self.deslizar(derecha)
    assert.equals(escalaTablero.posicionCelda(4, 8), jardinero.position())
    assert.equals(izquierda, jardinero.direccion())
    assert.notThat(jardinero.estaDeslizando())
  }

  test "se pueden florecer todas las cruces siguiendo la ruta del mapa 3" {
    self.deslizar(derecha)
    assert.equals(semillaRoja, jardinero.semillaEnMano())
    self.deslizar(abajo)
    assert.equals(semillaAmarilla, jardinero.semillaEnMano())
    self.deslizar(derecha)

    assert.that(partida.ganado())
    assert.that(partida.cruces().all({ cruz => cruz.florecida() }))
  }
}
